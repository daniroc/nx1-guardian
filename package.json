{
  "name": "@nx1/guardian-lab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {".": {"types": "./dist/src/index.d.ts", "import": "./dist/src/index.js"}},
  "files": ["dist/src", "README.md", "docs"],
  "engines": {"node": ">=24.21.0 <25"},
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "node scripts/lint.mjs",
    "test": "node --permission --allow-fs-read=. --allow-fs-write=.lab-tests --allow-fs-write=.lab-tests/* --test --test-isolation=none --test-concurrency=1 dist/test/*.test.js"
  },
  "devDependencies": {"@types/node": "26.1.0", "typescript": "5.9.3"}
}
